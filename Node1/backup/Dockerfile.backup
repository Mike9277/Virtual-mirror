FROM nvcr.io/nvidia/doca/doca:3.1.0-devel-host

ENV TZ=US \
    DEBIAN_FRONTEND=noninteractive

# ========================
# System deps + Python
# ========================
RUN apt-get update && apt-get install -y \
    curl wget gnupg2 \
    python3 python3-dev python3-pip python3-numpy \
    ninja-build build-essential cmake git \
    ffmpeg ssh sshpass openssh-client jq \
    libgl1 libglib2.0-0 \
    bc libopencv-dev \
    libgflags-dev libgoogle-glog-dev libprotobuf-dev protobuf-compiler \
    libboost-all-dev libhdf5-serial-dev \
    libatlas-base-dev \
    libpcre3 libpcre3-dev zlib1g zlib1g-dev \
    apt-transport-https ca-certificates \
    lsb-release gnupg \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Node.js 20
# -------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Docker CLI only
# -------------------------
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
       | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# ---------- Build OpenSSL 3.5.0 ----------
RUN mkdir -p /opt/src \
 && cd /opt/src \
 && curl -LO https://www.openssl.org/source/openssl-3.5.0.tar.gz \
 && tar xzf openssl-3.5.0.tar.gz \
 && cd openssl-3.5.0 \
 && ./Configure linux-x86_64 no-shared \
      --prefix=/opt/src/openssl-3.5.0/.openssl \
      --libdir=lib64 \
 && make -j"$(nproc)" \
 && make install_sw

# ---------- Build nginx 1.27.4 ----------
RUN cd /opt/src \
 && curl -LO http://nginx.org/download/nginx-1.27.4.tar.gz \
 && tar xzf nginx-1.27.4.tar.gz \
 && cd nginx-1.27.4 \
 && ./configure \
      --prefix=/opt/nginx-pqc \
      --with-http_ssl_module \
      --with-http_v2_module \
      --with-http_stub_status_module \
      --with-http_gzip_static_module \
      --with-stream \
      --with-stream_ssl_module \
      --with-pcre-jit \
      --with-cc-opt="-I/opt/src/openssl-3.5.0/.openssl/include" \
      --with-ld-opt="-L/opt/src/openssl-3.5.0/.openssl/lib64 -Wl,-rpath,/opt/src/openssl-3.5.0/.openssl/lib64" \
 && make -j"$(nproc)" \
 && make install \
 && ln -s /opt/nginx-pqc/sbin/nginx /usr/local/sbin/nginx
#Copy Docker file
COPY docker/nginx-pqc-entrypoint.sh /usr/local/bin/nginx-pqc-entrypoint.sh
RUN chmod +x /usr/local/bin/nginx-pqc-entrypoint.sh
# OpenSSL/nginx config dirs
RUN mkdir -p /opt/openssl-3.5/ssl \
    && mkdir -p /opt/nginx-pqc/conf/sites-available \
    && mkdir -p /opt/nginx-pqc/conf/sites-enabled \
    && mkdir -p /etc/nginx/ssl

COPY certs/backend-cert.pem /etc/nginx/ssl/backend-cert.pem
COPY certs/backend-key.pem  /etc/nginx/ssl/backend-key.pem

COPY config/pqc-openssl.cnf /opt/openssl-3.5/ssl/pqc-openssl.cnf
COPY config/nginx.conf        /opt/nginx-pqc/conf/nginx.conf
COPY config/flask-test.conf   /opt/nginx-pqc/conf/sites-available/flask-test.conf

RUN ln -sf /opt/nginx-pqc/conf/sites-available/flask-test.conf \
           /opt/nginx-pqc/conf/sites-enabled/flask-test.conf

# -------------------------
# Python deps
# -------------------------
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir \
        flask requests flask-cors pillow opencv-python \
        numpy scipy matplotlib scikit-image \
    && python3 -m pip install --no-cache-dir \
        torch torchvision --index-url https://download.pytorch.org/whl/cpu

# ========================
# App code
# ========================
WORKDIR /app
COPY . .
COPY rdma-container/ /app/rdma-container/

# Meson C++ app
WORKDIR /app/rdma-container
RUN apt-get remove -y meson || true \
    && python3 -m pip install meson pybind11 \
    && meson setup builddir-release -Dbuildtype=release \
    && meson compile -C builddir-release

ENV PYTHONPATH=/app/rdma-container/builddir-release

# Node web app
WORKDIR /app/web_app/viton
RUN npm install

# SSH: generate key only (do runtime provisioning instead of in build)
WORKDIR /app
RUN ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" -q

# Optional: REMOVE SSH password/sshpass stuff from build

# Update env_config.json
RUN jq '.MAIN_DIR="/app"' env_config.json > env_config_tmp.json \
    && mv env_config_tmp.json env_config.json

# Build OpenPose CPU-only
WORKDIR /app/openpose
RUN rm -rf build && mkdir build
WORKDIR /app/openpose/build
RUN cmake .. -DGPU_MODE=CPU_ONLY && make -j"$(nproc)"

ENV LD_LIBRARY_PATH=/app/openpose/build/src/openpose:$LD_LIBRARY_PATH

EXPOSE 3000 5000 8000

# Make sure this script exists and is executable, or change entrypoint
# COPY nginx-pqc-entrypoint.sh /usr/local/bin/nginx-pqc-entrypoint.sh
# RUN chmod +x /usr/local/bin/nginx-pqc-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/nginx-pqc-entrypoint.sh"]
CMD ["nginx"]
