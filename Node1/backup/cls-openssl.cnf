# /opt/openssl-3.5/ssl/pqc-openssl.cnf
# Loaded via OPENSSL_CONF inside the container.

openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# Allow TLS 1.2 and 1.3 globally; the nginx vhost will restrict to TLS 1.3
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.3

# Reasonable default cipher string
CipherString = DEFAULT@SECLEVEL=2

# IMPORTANT: allow both classical and PQC hybrid groups.
# Order: try hybrid first, then classical X25519, then P-256.
# If a client doesn't support MLKEM, it will negotiate X25519 or secp256r1.
Groups = X25519MLKEM768:X25519:secp256r1
