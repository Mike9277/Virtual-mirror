openssl_conf = default_conf

[ default_conf ]
ssl_conf = ssl_sect

[ ssl_sect ]
system_default = system_default_sect

[ system_default_sect ]
# Only TLS 1.3
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3

# Prefer this hybrid PQ group
Groups = X25519MLKEM768

# Enforce AES-256-GCM as the TLS 1.3 cipher
Ciphersuites = TLS_AES_256_GCM_SHA384
